<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to: android/app/src/main/res/xml/sea_condition_widget_info.xml

  updatePeriodMillis is Android's own OS-level fallback refresh (the
  platform enforces a practical floor around 30 min and may batch it
  regardless of the value set here) — the precise, user-configurable
  refresh interval from Settings is actually driven by the WorkManager
  periodic task registered in BackgroundRefreshService, not by this
  value. Keep both: this one guarantees at least occasional refreshes
  even if WorkManager is ever killed by an aggressive OEM battery
  optimizer.

  minHeight/targetCellHeight: the widget's actual content (header, big
  number + rating pill, subtitle, 2x2 metric grid, "Updated" line) only
  needs about 190dp. minHeight is that floor. targetCellHeight tells
  Android-12+ launchers how many grid rows to allocate by default —
  3 rows reserves noticeably more vertical space than the content uses,
  leaving empty gradient below it; 2 rows is a much closer match.
-->

<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="190dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/sea_condition_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/sea_condition_widget"
    android:configure="com.shorecast.shorecast_app.WidgetConfigureActivity" />
