<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to: android/app/src/main/res/drawable/radio_row_background.xml
     Each metric option is a full-width "card" row using this as its
     background. The checked state (state_checked, driven automatically by
     RadioButton's own isChecked()) gets a brighter accent-tinted fill and
     border so the selected option stands out clearly; unchecked rows stay
     a subtle frosted card. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#330072BE" />
            <stroke android:width="1.5dp" android:color="#3DD9F5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
